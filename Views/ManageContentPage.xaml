<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PimVIII.MauiCreator.Views.ManageContentPage"
             Title="Gestão de Conteúdo">

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0" Margin="10"
                        ItemsSource="{Binding Conteudos}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="5" StrokeShape="RoundRectangle 10"
                StrokeThickness="1" Stroke="LightGray">

                        <Grid ColumnDefinitions="*, Auto">

                            <VerticalStackLayout Grid.Column="0" 
                                     VerticalOptions="Center">
                                <Label Text="{Binding Titulo}" 
                           FontAttributes="Bold" />
                                <Label Text="{Binding Tipo}" 
                           FontSize="Small" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" 
                       Spacing="10" 
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       Margin="0,0,10,0">

                                <ImageButton Source="icon1.png"
                                     HeightRequest="30"
                                     WidthRequest="30"
                                     BackgroundColor="Transparent"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditConteudoCommand}"
                                     CommandParameter="{Binding .}" />

                                <ImageButton Source="icon2.png"
                                     HeightRequest="30"
                                     WidthRequest="30"
                                     BackgroundColor="Transparent"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteConteudoCommand}"
                                     CommandParameter="{Binding .}" />

                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" 
                Text="Adicionar Novo Conteúdo" 
                Margin="10"
                Command="{Binding GoToAddPageCommand}" />

    </Grid>
</ContentPage>