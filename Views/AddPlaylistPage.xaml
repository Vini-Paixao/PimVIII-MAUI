<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PimVIII.MauiCreator.Views.AddPlaylistPage"
             Title="Adicionar Nova Playlist">

    <VerticalStackLayout Spacing="10" Margin="20">

        <Label Text="Nome da Playlist" />
        <Entry Placeholder="Ex: Minhas Aulas de POO" 
               Text="{Binding Nome, Mode=TwoWay}" />

        <Button Text="Salvar Playlist" 
                Margin="0,20,0,0"
                Command="{Binding SavePlaylistCommand}" />

    </VerticalStackLayout>
</ContentPage>